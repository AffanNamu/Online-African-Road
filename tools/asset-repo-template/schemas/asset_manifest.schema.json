{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "ARO asset manifest",
 "type": "object",
 "required": ["id", "version", "kind", "files", "source", "madeBy", "licence", "references", "budgets"],
 "properties": {
  "id": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"},
  "version": {"type": "integer", "minimum": 1},
  "kind": {"enum": ["buildings", "vegetation", "signs", "lights", "props", "environments", "roads", "vehicles"]},
  "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer"}}}},
  "source": {"type": "object", "required": ["blend", "script", "toolchain"], "properties": {"blend": {"type": "string"}, "script": {"type": "string"}, "toolchain": {"type": "string"}}},
  "madeBy": {"type": "object", "required": ["human", "tools"], "properties": {"human": {"type": "string"}, "tools": {"type": "array", "items": {"type": "string"}}}},
  "licence": {"type": "object", "required": ["kind", "evidence"], "properties": {"kind": {"enum": ["owner-owned", "licensed", "commissioned"]}, "evidence": {"type": "string"}}},
  "references": {"type": "array", "items": {"type": "string", "pattern": "^R-[0-9]{3}$"}},
  "budgets": {"type": "object", "required": ["lodTriangles"], "properties": {"lodTriangles": {"type": "array", "items": {"type": "integer"}}}},
  "catalogEntry": {"type": "object"},
  "approval": {"type": ["object", "null"], "properties": {"by": {"type": "string"}, "at": {"type": "string"}}}
 }
}
